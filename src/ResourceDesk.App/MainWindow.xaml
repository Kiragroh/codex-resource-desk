<Window x:Class="ResourceDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Resource Desk — for Codex" Icon="Assets/ResourceDesk.ico" Width="1260" Height="900" MinWidth="1030" MinHeight="730" Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#F0F4F8">
 <Grid Background="{StaticResource BackgroundBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111820" BorderBrush="#26303B" BorderThickness="0,0,1,0">
   <Grid Margin="12,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image Source="Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Resource Desk · an independent tool for Codex" AutomationProperties.Name="Resource Desk logo"/>
    <StackPanel Grid.Row="1" Margin="0,36,0,0"><Border Background="#16374F" CornerRadius="10" Height="45"><TextBlock Text="▥" Foreground="#008AC9" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="DESK" FontSize="9" Foreground="#008AC9" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel>
    <TextBlock Grid.Row="2" Text="0.1" HorizontalAlignment="Center" Foreground="#697C90" FontSize="11"/>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="26,18,26,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="RESOURCE DESK  /  FOR CODEX" Style="{StaticResource Caption}" Foreground="#008AC9"/><TextBlock Text="A clear view. More headroom." FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="See what your tools use. Keep what you need." Foreground="#97A7B9" FontSize="13" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Border Background="#16374F" CornerRadius="6" Padding="10,7" Margin="0,0,10,0"><TextBlock x:Name="LiveLabel" Text="● LIVE · 5s" Foreground="#008AC9" FontSize="11"/></Border><Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" Margin="0,0,7,0" ToolTip="Pause monitoring. This does not stop any Codex process."/><Button Content="Refresh" Click="Refresh_Click" Margin="0,0,7,0"/><Button Content="Settings" Click="Settings_Click"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.13*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,12,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="SYSTEM MEMORY" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="{Binding SystemUsed}" Style="{StaticResource Metric}"/><TextBlock Text="{Binding SystemTotal}" Foreground="#97A7B9" FontSize="15" VerticalAlignment="Bottom" Margin="8,0,0,7"/></StackPanel><ProgressBar Height="7" Margin="0,12,0,10" Value="{Binding SystemPercent, Mode=OneWay}" Maximum="100" Background="#2D3A48" Foreground="#8098C6" BorderThickness="0" ToolTip="{Binding SystemTip}"/><TextBlock Text="{Binding SystemFree}" Foreground="#97A7B9" FontSize="12"/></StackPanel></Border>
    <Border Grid.Column="1" Background="#142638" CornerRadius="14" Padding="16" Margin="0,0,12,0" BorderBrush="#315779" BorderThickness="1" ToolTip="Private resident memory of the verified Codex process tree. Shared pages are excluded. Committed memory is shown separately and can include paged-out memory."><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="CODEX · RESIDENT RAM" Style="{StaticResource Caption}" Foreground="#A7C5DB"/><TextBlock Grid.Row="1" Text="{Binding CodexRam}" Style="{StaticResource Metric}" Foreground="#80CCEE" Margin="0,9,0,0"/><StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding CodexCommit}" Foreground="#A7C5DB" FontSize="12"/><Canvas Height="15" Margin="0,6,0,0" ClipToBounds="True"><Polyline Points="{Binding HistoryPoints}" Stroke="#008AC9" StrokeThickness="1.5"/></Canvas></StackPanel></Grid></Border>
    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="CODEX PROCESSES" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ProcessCount}" Style="{StaticResource Metric}" Margin="0,9,0,0"/><TextBlock Text="{Binding RunningTools}" Foreground="#97A7B9" FontSize="12" Margin="0,14,0,0"/><TextBlock Text="{Binding DisabledTools}" Foreground="#97A7B9" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
   </Grid>
   <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="17,13" Margin="0,0,0,16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><StackPanel><DockPanel Margin="0,0,0,10"><TextBlock Text="WHERE CODEX MEMORY GOES" Style="{StaticResource Caption}"/><TextBlock DockPanel.Dock="Right" Text="Hover to inspect · click to focus" Foreground="#73869B" FontSize="11" HorizontalAlignment="Right"/></DockPanel><Grid x:Name="BreakdownBar" Height="15"/><WrapPanel x:Name="BreakdownLegend" Margin="0,10,0,0"/></StackPanel></Border>
   <Border Grid.Row="3" x:Name="NoticeBorder" Background="#1D2C3B" CornerRadius="8" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#C6DDF5" FontSize="12"/></Border>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your integrations" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Disabled tools stay here. Nothing gets lost." Foreground="#7F92A7" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AllFilter" Content="All" Tag="All" Click="Filter_Click" Padding="10,7" Margin="0,0,5,0"/><Button x:Name="RunningFilter" Content="Running" Tag="Running" Click="Filter_Click" Padding="10,7" Margin="0,0,5,0"/><Button x:Name="DisabledFilter" Content="Disabled" Tag="Disabled" Click="Filter_Click" Padding="10,7"/></StackPanel></Grid>
     <DockPanel Grid.Row="1"><TextBlock Text="Search" Foreground="#7F92A7" FontSize="11" Margin="0,9,10,0"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search integration names" AutomationProperties.Name="Search integrations" Margin="0,0,0,10"/></DockPanel>
     <ListBox Grid.Row="2" x:Name="ComponentsList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionChanged="Selection_Changed" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" Padding="0">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowBorder" CornerRadius="10" Background="#151C24" BorderBrush="#273341" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="#008AC9"/><Setter TargetName="RowBorder" Property="Background" Value="#1B2D43"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#202D37"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowBorder" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="13,12" ToolTip="{Binding Hover}"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
       <Border Width="30" Height="30" CornerRadius="9" Background="{Binding Tint}" VerticalAlignment="Top"><TextBlock Text="{Binding Initial}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#9CAFBD" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><ProgressBar Height="3" Margin="0,8,12,0" Value="{Binding RamPercent, Mode=OneWay}" Maximum="100" Background="#2C3A46" Foreground="{Binding Tint}" BorderThickness="0"/></StackPanel>
       <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Ram}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Count}" Foreground="#879BAF" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Right"/></StackPanel>
       <Grid Grid.Column="3" HorizontalAlignment="Right"><Button Style="{StaticResource Switch}" Click="Toggle_Click" Visibility="{Binding SwitchVisibility}" IsEnabled="{Binding CanAct}" ToolTip="{Binding ToggleTip}" AutomationProperties.Name="{Binding ToggleTip}"/><TextBlock Text="{Binding ReadOnlyLabel}" Foreground="#728399" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ReadOnlyVisibility}"/></Grid>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Border Grid.Column="1" Background="#121A23" CornerRadius="12" BorderBrush="#2A3441" BorderThickness="1" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="INSPECTOR" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.Status}" Foreground="#008AC9" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
     <TextBlock Grid.Row="1" Text="{Binding Selected.Explanation}" ToolTip="{Binding Selected.Explanation}" Foreground="#A7B8C9" FontSize="11" TextWrapping="Wrap" MaxHeight="44" Margin="0,8,0,8"/>
     <Grid Grid.Row="2" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PRIVATE RAM" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Selected.Ram}" FontSize="20" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="COMMITTED" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Selected.Commit}" FontSize="20" Margin="0,4,0,0" ToolTip="Private committed memory. Includes memory that may be paged out; this is not additional physical RAM."/></StackPanel></Grid>
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MinHeight="32"><StackPanel><TextBlock Text="{Binding Selected.EmptyText}" Foreground="#7F94A9" FontSize="12" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Selected.ProcessRows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#273440" BorderThickness="0,0,0,1" Padding="0,9"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontSize="11"/><TextBlock Text="{Binding Ram}" Foreground="#A6BACD" FontSize="11" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding Detail}" Foreground="#728AA0" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
     <StackPanel Grid.Row="4" Margin="0,8,0,0"><Button Content="Stop this integration" Click="Stop_Click" IsEnabled="{Binding CanStopSelected}" ToolTip="Disconnect only this integration's verified processes. Does not change its enabled setting."/><TextBlock Text="{Binding Selected.ControlNote}" FontSize="10" Foreground="#7E94A9" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    </Grid></Border>
   </Grid>
   <Grid Grid.Row="5" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Footer}" FontSize="10" Foreground="#7E91A6"/><TextBlock Text="Independent companion · not affiliated with OpenAI · no telemetry" FontSize="10" Foreground="#5C7188" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Undo last switch" Click="Undo_Click" IsEnabled="{Binding CanUndo}" Padding="12,7" Margin="0,0,8,0"/><Button Content="Export snapshot" Click="Export_Click" Padding="12,7"/></StackPanel></Grid>
  </Grid>
 </Grid>
</Window>
